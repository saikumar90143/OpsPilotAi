# OpsPilot AI - environment template.
# Copy to `.env` in the repository root (git-ignored) and replace every placeholder:
#     Copy-Item .env.example .env        (PowerShell)
#     cp .env.example .env               (macOS/Linux)
# Never commit `.env`. Use URL-safe characters (letters, digits, - _ .) in passwords
# because they are embedded in connection URLs.

# --- PostgreSQL (Docker Compose `db` service) ------------------------------------
# NOTE: PostgreSQL applies these only when its data volume is first initialised.
# Changing them later does NOT change the password inside an existing volume.
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=replace-with-a-local-password

# --- API ----------------------------------------------------------------------------
APP_NAME=OpsPilot AI API
APP_ENV=development
# Local runs from backend/ default to SQLite. Docker Compose ignores this value and
# builds a PostgreSQL URL from the POSTGRES_* variables above.
DATABASE_URL=sqlite:///./opspilot.db
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
# console | json (default: json when APP_ENV=production, console otherwise)
# LOG_FORMAT=console

# --- Authentication & sessions (Phase 2) --------------------------------------------
# Generate a real 32+ char secret before deploying: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-32-plus-char-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITATION_EXPIRE_HOURS=72
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Event ingestion & Redis/Celery (Phase 4) ---------------------------------------
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INTEGRATION_ENCRYPTION_KEY=replace-with-fernet-key-in-production
WEBHOOK_MAX_BYTES=262144

# --- PostgreSQL integration tests ------------------------------------------------
# Start the ephemeral test database:  docker compose --profile test up -d db-test
# The database name must end in _test (tests reset its schema).
# TEST_POSTGRES_PORT=55432
# TEST_POSTGRES_URL=postgresql+psycopg://opspilot:replace-with-a-local-password@127.0.0.1:55432/opspilot_test
