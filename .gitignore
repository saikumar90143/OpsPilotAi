# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Testing & coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ─── Type checking ────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ─── Linting ──────────────────────────────────────────────────────────────────
.ruff_cache/

# ─── Databases (never commit local databases) ─────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ─── Environment files (never commit real secrets) ────────────────────────────
.env
.env.local
.env.*.local

# ─── Alembic compiled ─────────────────────────────────────────────────────────
alembic/versions/__pycache__/

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Frontend ─────────────────────────────────────────────────────────────────
node_modules/
.next/
dist/
build/
frontend/.env
frontend/.env.local
frontend/playwright/.auth/
frontend/playwright-report/
frontend/test-results/

# ─── Docker ───────────────────────────────────────────────────────────────────
# (docker-compose.override.yml is intentionally not ignored — commit it if used)
